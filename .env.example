# =============================================================================
# XAA Inspector configuration
#
# Copy this file to `.env` and fill in the values. You must configure:
#   1. Server settings (below)
#   2. The Okta token-exchange client (Section 2)
#   3. AT LEAST ONE enterprise IdP: OIDC (Section 3) or SAML (Section 4)
#   4. Auth0 (Section 5)
#
# OIDC and SAML can both be configured at once - the UI shows a toggle to
# switch between them. If only one is configured, the app boots into it and
# disables the other.
# =============================================================================

# --- 1. Server ---------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# Required. A long, random string used to sign the session cookie.
SESSION_SECRET=your-super-secret-session-key-here-make-it-long-and-random


# --- 2. Okta org authorization server ----------------------------------------
# OKTA_ISSUER is your Okta tenant URL (e.g. https://your-domain.okta.com). This
# is the org authorization server that mints the Identity Assertion JWT (ID-JAG).
# Always required.
OKTA_ISSUER=https://your-domain.okta.com

# The token exchange (ID Token/SAML -> ID-JAG) needs a client. A basic OIDC
# setup reuses OKTA_CLIENT_ID / OKTA_CLIENT_SECRET from Section 3, so the
# variables below are OPTIONAL and only needed for:
#   - AI agent token exchange (an Okta AI Agent using private_key_jwt), or
#   - the SAML flow.
#
# Dedicated token-exchange client_id (e.g. the Okta AI Agent's client_id). If
# unset, OKTA_CLIENT_ID (Section 3) is used instead.
# OKTA_TOKEN_CLIENT_ID=your-token-client-id

# Scopes requested in the ID Token -> ID-JAG exchange (OIDC flow).
OKTA_TOKEN_SCOPE=read write

# Token-endpoint auth method: private_key_jwt (default) or client_secret.
# Okta AI Agents authenticate with a signed "JWT with private key"
# (private_key_jwt). Set this to client_secret for a basic OIDC client_secret
# exchange.
OKTA_AUTH_METHOD=private_key_jwt

# --- Required only when OKTA_AUTH_METHOD=private_key_jwt ---
# The private key (and its kid) from the Okta AI Agent registration.
OKTA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OKTA_PRIVATE_KEY_KID=your-key-id-here


# --- 3. Enterprise IdP: OIDC -------------------------------------------------
# Uncomment this block to authenticate the user via an OIDC IdP (Okta). Only
# needed for the OIDC flow; leave it commented for a SAML-only setup. The OIDC
# flow is enabled as soon as OKTA_CLIENT_ID and OKTA_CLIENT_SECRET are set.
# OKTA_CLIENT_ID=your-okta-client-id
# OKTA_CLIENT_SECRET=your-okta-client-secret


# --- 4. Enterprise IdP: SAML -------------------------------------------------
# Uncomment this block to configure a SAML IdP instead of (or in addition to)
# OIDC. SAML is only used to authenticate the user; the token exchanges still
# use the Okta client from Section 2. The SAML flow is enabled as soon as
# SAML_IDP_SSO_URL and SAML_IDP_CERT are set.
#
# REQUIRED: the SAML flow only works against an Okta AI Agent, so Section 2 must
# set OKTA_AUTH_METHOD=private_key_jwt (plus OKTA_PRIVATE_KEY / OKTA_PRIVATE_KEY_KID).
# A client_secret will not work for the SAML token exchanges.
#
# SP entity id (matches the SP Entity ID configured in the Okta SAML app)
# SAML_SP_ENTITY_ID=http://localhost:3000/saml/metadata
# Where the IdP posts the SAMLResponse (our Assertion Consumer Service)
# SAML_SP_ACS_URL=http://localhost:3000/saml/callback
# IdP single sign-on URL (from the Okta SAML app "Sign On" details)
# SAML_IDP_SSO_URL=https://your-domain.okta.com/app/xxx/sso/saml
# IdP entity id / issuer
# SAML_IDP_ISSUER=http://www.okta.com/xxxxxxxx
# IdP signing certificate (PEM on one line with literal \n), used to validate
# the SAML response signature
# SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#
# Scope for the SAML Assertion -> Refresh Token exchange
# SAML_RT_SCOPE=openid offline_access
# Scope for the Refresh Token -> ID-JAG exchange
# SAML_IDJAG_SCOPE=read:item


# --- 5. Auth0 (Resource Application) -----------------------------------------
AUTH0_DOMAIN=your-domain.auth0.com

# AUTH0_CLIENT_ID identifies the Requesting App to Auth0 (the Resource App
# authorization server). Two options:
#
#   a) A pre-registered client: use the client_id of a Requesting App you
#      registered in the Auth0 dashboard, together with AUTH0_CLIENT_SECRET.
#
#   b) A Client ID Metadata Document (CIMD) URL: instead of pre-registering,
#      set AUTH0_CLIENT_ID to the HTTPS URL of a hosted CIMD JSON document.
#      Auth0 dereferences the URL to discover the client. This repo ships one
#      at ./cimd.json, served publicly from the default branch, e.g.
#      https://raw.githubusercontent.com/mipdr/auth0-cross-app-access-inspector/main/cimd.json
#      The document declares token_endpoint_auth_method="none" (a public
#      client), so leave AUTH0_CLIENT_SECRET unset when using CIMD. See the
#      README "Client ID Metadata Document (CIMD)" section for details.
AUTH0_CLIENT_ID=your-auth0-client-id
# AUTH0_CLIENT_SECRET is OPTIONAL. Set it for a confidential pre-registered
# client. Leave it unset for a public client (e.g. a CIMD document declaring
# token_endpoint_auth_method="none"); no client_secret param is then sent.
# AUTH0_CLIENT_SECRET=your-auth0-client-secret
# The API identifier (audience) for the Resource Application in Auth0.
AUTH0_AUDIENCE=https://your-domain.auth0.com/

# Optional: when set, adds a `resource` param to the final access-token call.
# AUTH0_RESOURCE=https://your-resource-server
